# w2mcp — copy to `.env` (or run `w2mcp init`). Any OpenAI-compatible endpoint works.

LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Examples — uncomment ONE pair:
#   Gemini      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   LLM_MODEL=gemini-2.5-flash
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1                              LLM_MODEL=openai/gpt-4o-mini
#   Groq        LLM_BASE_URL=https://api.groq.com/openai/v1                            LLM_MODEL=llama-3.3-70b-versatile
#   Ollama      LLM_BASE_URL=http://localhost:11434/v1   LLM_API_KEY=ollama            LLM_MODEL=llama3.1
#   Anthropic   LLM_BASE_URL=https://api.anthropic.com/v1                              LLM_MODEL=claude-sonnet-5

# Optional — only for the hosted gateway (`npx tsx src/gateway-cli.ts`):
# W2MCP_MASTER_KEY=<64 hex chars: openssl rand -hex 32>
# DATABASE_URL=postgres://...
