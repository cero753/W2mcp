{
  "name": "w2mcp",
  "version": "0.2.0",
  "description": "Turn any API's docs URL into a working MCP server — no OpenAPI spec required. Bring your own LLM.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "w2mcp": "bin/w2mcp.mjs"
  },
  "engines": {
    "node": ">=20.12"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "w2mcp": "tsx src/use-cli.ts",
    "pipeline": "tsx src/cli.ts",
    "use": "tsx src/use-cli.ts",
    "hub": "tsx src/hub.ts",
    "drift": "tsx src/drift-cli.ts",
    "verify": "tsx src/verify-cli.ts",
    "gen": "tsx src/gen-cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "openai": "^6.42.0",
    "pg": "^8.21.0",
    "playwright": "^1.60.0",
    "turndown": "^7.2.0",
    "tsx": "^4.19.0",
    "yaml": "^2.9.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/turndown": "^5.0.5",
    "supabase": "^2.107.0",
    "typescript": "^5.7.0"
  }
}
