    "turndown": "^7.2.0",
    "yaml": "^2.9.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/turndown": "^5.0.5",
    "supabase": "^2.107.0",
